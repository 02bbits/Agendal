# Production env for compose.prod.yml (IM-65). Copy to backend/.env.production on the server,
# fill the <...> values, chmod 600. Never commit the real file (it is git-ignored).
APP_NAME=Agendal
APP_ENV=production
# ASVS 14.3.2: debug off
APP_DEBUG=false
# docker compose -f compose.prod.yml run --rm --no-deps api php artisan key:generate --show
APP_KEY=<base64:...>
APP_URL=https://<domain>
FRONTEND_URL=https://<domain>
SANCTUM_STATEFUL_DOMAINS=<domain>
# Client IP from Cloudflare (TrustCloudflareIp); safe only because the API is reachable through the tunnel alone
TRUST_CF_CONNECTING_IP=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=agendal
DB_USERNAME=agendal
# The same value as secrets/db_password
DB_PASSWORD=<db password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database

# Resend over SMTP. The password is a Resend API key with "Sending access" for <domain> only
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=<re_...>
MAIL_FROM_ADDRESS="no-reply@<domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Language-model fallback (ADR-008). The key is the Docker secret secrets/gemini_api_key, never this file
NOTE_LLM_ENABLED=true
NOTE_LLM_PROVIDER=gemini
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key

# Web Push reminders (TK-6). The private key is the Docker secret secrets/vapid_private_key, never this file
VAPID_PUBLIC_KEY=<from push:vapid>
VAPID_PRIVATE_KEY_FILE=/run/secrets/vapid_private_key
VAPID_SUBJECT="mailto:<a team address>"
NOTE_LLM_DAILY_USER_CALLS=20
NOTE_LLM_DAILY_TOKENS=1000000
