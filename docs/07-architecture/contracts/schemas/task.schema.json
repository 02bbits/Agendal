{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agendal.app/schemas/task.schema.json",
  "title": "Task",
  "description": "A task as the API returns it (TK §7, data model). Dates and times are floating local values (ADR-006).",
  "type": "object",
  "required": ["id", "title", "due_date", "start_time", "end_time", "priority", "project_id", "repeat", "reminder", "notes", "done", "done_at", "created_by", "source_note_id", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "title": { "$ref": "#/$defs/title" },
    "due_date": { "$ref": "#/$defs/date" },
    "start_time": { "$ref": "#/$defs/time" },
    "end_time": { "$ref": "#/$defs/time" },
    "priority": { "$ref": "#/$defs/priority" },
    "project_id": { "$ref": "#/$defs/uuid_or_null" },
    "repeat": { "$ref": "#/$defs/repeat" },
    "reminder": { "$ref": "#/$defs/reminder" },
    "notes": { "$ref": "#/$defs/notes" },
    "done": { "type": "boolean" },
    "done_at": { "type": ["string", "null"], "format": "date-time" },
    "created_by": { "enum": ["user", "assistant"] },
    "source_note_id": { "$ref": "#/$defs/uuid_or_null" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "uuid_or_null": { "type": ["string", "null"], "format": "uuid" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "date": { "type": ["string", "null"], "format": "date" },
    "time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "priority": { "enum": ["low", "medium", "high", null] },
    "repeat": { "enum": ["never", "daily", "weekly", "monthly", "yearly"] },
    "reminder": { "enum": ["none", "5m", "15m", "30m", "1h", "1d"] },
    "notes": { "type": ["string", "null"], "maxLength": 5000 }
  }
}
