{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agendal.app/schemas/error.schema.json",
  "title": "Error",
  "description": "Every error response (api.md conventions). `code` is a copy-catalog key. `fields` maps a request field to its messages (422). `tasks` lists conflicting tasks for 409 note.undo_conflicts (RV §7). `retry_after` is the lock length in seconds for 429 auth.locked (AA §7).",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" },
        "message": { "type": "string" },
        "request_id": { "type": "string" },
        "retry_after": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "title": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
